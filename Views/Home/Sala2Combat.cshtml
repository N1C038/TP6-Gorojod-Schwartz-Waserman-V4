@{
    ViewData["Title"] = "Sala 2";
    var mensaje = TempData["Sala2Mensaje"] as string;
}

<div class="sala2-scene">
    <div class="text-center mb-4">
        <h2>Sala 2: La bestia que imita a Zote</h2>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-info mt-3">@mensaje</div>
    }

    <p class="sala2-intro">
        Te adentras en la segunda cámara y descubres a un guerrero enorme, imponente, con la figura de <strong>El gran Zote</strong>.
        Al acercarte, notas que su mirada es demasiado fría y que sus movimientos se vuelven animalescos.
        No es Zote: es <strong>Nosk</strong>, una bestia cazadora que se mimetiza para atraer a sus víctimas.
    </p>

    <div class="sala2-combat">
        <div id="prebattleOverlay" style="position:fixed;inset:0;background:rgba(0,0,0,0.85);display:flex;align-items:center;justify-content:center;z-index:9999;">
            <div style="background:#111;color:#fff;padding:18px;border-radius:10px;display:flex;gap:16px;align-items:center;max-width:900px;width:90%;">
                <div style="width:200px;flex:0 0 200px;">
                    <img src="/Images/zoteNosk.png" alt="Zote extraño" style="width:100%;border-radius:8px;border:2px solid #333;" />
                </div>
                <div style="flex:1;">
                    <h3 style="margin:0 0 6px 0;">Zote parece extraño...</h3>
                    <p style="margin:0 0 6px 0;">Lo observas y notas que su comportamiento no es el habitual. Algo no está bien...</p>
                    <div style="margin-top:8px;font-size:13px;opacity:0.9;">Presioná "Empezar combate" cuando estés listo.</div>
                    <div style="margin-top:12px;">
                        <button id="startCombatBtn" class="btn btn-danger">Empezar combate</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="sala2-beast" aria-label="Enemigo Nosk" style="position:relative;max-width:600px;margin:0 auto;">
            <img src="/Images/zoteNosk 2.png" alt="Nosk" style="width:100%;display:block;border-radius:6px;" />
            <div class="sala2-part part-head" data-part="cabeza" style="position:absolute;left:60%;top:70%;width:16%;height:14%;"></div>
            <div class="sala2-part part-body" data-part="cuerpo" style="position:absolute;left:30%;top:50%;width:28%;height:30%;"></div>
            <div class="sala2-part part-left-arm" data-part="brazo izquierdo" style="position:absolute;left:18%;top:22%;width:20%;height:18%;"></div>
            <div class="sala2-part part-right-arm" data-part="brazo derecho" style="position:absolute;left:62%;top:22%;width:20%;height:18%;"></div>
            <div class="sala2-part part-left-leg" data-part="pierna izquierda" style="position:absolute;left:36%;top:52%;width:14%;height:28%;"></div>
            <div class="sala2-part part-right-leg" data-part="pierna derecha" style="position:absolute;left:50%;top:52%;width:14%;height:28%;"></div>
        </div>

        <div class="sala2-panel">
            <div class="sala2-status">
                <div class="sala2-bar-wrap">
                    <span>Nosk</span>
                    <div class="sala2-bar">
                        <div id="enemyHpBar" class="sala2-fill enemy"></div>
                    </div>
                </div>
                <div class="sala2-bar-wrap">
                    <span>Tu energía</span>
                    <div class="sala2-bar player">
                        <div id="playerHpBar" class="sala2-fill player"></div>
                    </div>
                </div>
            </div>

            <div id="combatStatus" class="sala2-status-text">
                Las extremidades de Nosk se tornan rojas. ¡Tocá la parte adecuada para hacerle daño!
            </div>

            <div id="nextRoomForm" class="sala2-next-room" style="display: none;">
                <p>¡Nosk cae! Del humo surge el verdadero Zote, quien te daría el poder de moverte con más rapidez y fuerza.</p>
                <p><strong>Pero tu aguijón está gravemente dañado por la batalla.</strong></p>
                <p>Zote te señala hacia el taller del herrero del reino. "Tu arma necesita ser forjada de nuevo," dice con solemnidad.</p>
                <form action='@Url.Action("irAForja", "Home")' method="GET">
                    <input type="submit" value="Ir a la Forja del Herrero" />
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const parts = document.querySelectorAll('.sala2-part');
    const enemyHpBar = document.getElementById('enemyHpBar');
    const playerHpBar = document.getElementById('playerHpBar');
    const combatStatus = document.getElementById('combatStatus');
    const nextRoomForm = document.getElementById('nextRoomForm');

    // Canvas overlay for recoloring dark pixels in image hotspots
    let beastImg = document.querySelector('.sala2-beast img');
    let canvas, ctx;
    function createCanvasOverlay(){
        if (!beastImg) return;
        const container = beastImg.parentElement;
        canvas = document.createElement('canvas');
        ctx = canvas.getContext('2d');
        canvas.style.position = 'absolute';
        canvas.style.top = '0';
        canvas.style.left = '0';
        canvas.style.width = '100%';
        canvas.style.height = '100%';
        canvas.style.pointerEvents = 'none';
        canvas.width = beastImg.naturalWidth || beastImg.width;
        canvas.height = beastImg.naturalHeight || beastImg.height;
        container.style.position = container.style.position || 'relative';
        container.appendChild(canvas);
        ctx.drawImage(beastImg,0,0,canvas.width,canvas.height);
        window.addEventListener('resize', ()=>{
            if(!canvas) return;
            canvas.width = beastImg.naturalWidth || beastImg.width;
            canvas.height = beastImg.naturalHeight || beastImg.height;
            ctx.drawImage(beastImg,0,0,canvas.width,canvas.height);
        });
    }
    if (beastImg && beastImg.complete) createCanvasOverlay(); else if(beastImg){ beastImg.addEventListener('load', createCanvasOverlay); }

    function clearTint(){ if (ctx && beastImg) ctx.drawImage(beastImg,0,0,canvas.width,canvas.height); }

    function tintActivePart(part){
        if(!ctx || !beastImg) return;
        ctx.drawImage(beastImg,0,0,canvas.width,canvas.height);
        const imgRect = beastImg.getBoundingClientRect();
        const partRect = part.getBoundingClientRect();
        const scaleX = canvas.width / imgRect.width;
        const scaleY = canvas.height / imgRect.height;
        const x = Math.max(0, Math.round((partRect.left - imgRect.left) * scaleX));
        const y = Math.max(0, Math.round((partRect.top - imgRect.top) * scaleY));
        const w = Math.max(1, Math.round(partRect.width * scaleX));
        const h = Math.max(1, Math.round(partRect.height * scaleY));
        try{
            const imgData = ctx.getImageData(x,y,w,h);
            const d = imgData.data;
            for(let i=0;i<d.length;i+=4){
                const r = d[i], g = d[i+1], b = d[i+2];
                const lum = 0.2126*r + 0.7152*g + 0.0722*b;
                if(lum < 110){ d[i]=255; d[i+1]=Math.round(g*0.22); d[i+2]=Math.round(b*0.22); }
            }
            ctx.putImageData(imgData, x, y);
        }catch(e){ console.warn('tintActivePart error', e); }
    }

    let enemyHp = 100;
    let playerHp = 100;
    let attackWindowOpen = false;
    let victory = false;
    let activeTimeout = null;
    let activePart = null;

    function resetParts() {
        parts.forEach(part => part.classList.remove('active', 'hit'));
    }

    function triggerEnemyAttack() {
        if (victory) return;

        resetParts();
        const randomIndex = Math.floor(Math.random() * parts.length);
        activePart = parts[randomIndex];
        activePart.classList.add('active');
        tintActivePart(activePart);
        attackWindowOpen = true;
        combatStatus.textContent = '¡La extremidad de Nosk se pone roja! Tocala para golpearlo.';

        window.clearTimeout(activeTimeout);
        activeTimeout = window.setTimeout(() => {
            if (!victory && attackWindowOpen) {
                attackWindowOpen = false;
                resetParts();
                activePart = null;
                playerHp = Math.max(0, playerHp - 12);
                // clear tint when attack window closes
                clearTint();
                playerHpBar.style.width = playerHp + '%';
                combatStatus.textContent = 'Nosk contraataca. ¡No dejes que te alcance!';

                if (playerHp <= 0) {
                    combatStatus.textContent = 'Te derriba la bestia. Inténtalo otra vez.';
                    parts.forEach(part => part.style.pointerEvents = 'none');
                    setTimeout(() => location.reload(), 1800);
                }
            }
        }, 650);
    }

    function doAttack(selectedPart) {
        if (victory) return;

        if (attackWindowOpen && selectedPart === activePart) {
            enemyHp = Math.max(0, enemyHp - 20);
            enemyHpBar.style.width = enemyHp + '%';
            selectedPart.classList.add('hit');
            resetParts();
            clearTint();
            attackWindowOpen = false;
            activePart = null;
            combatStatus.textContent = '¡Impacto directo! La ferocidad de Nosk empieza a ceder.';

            if (enemyHp <= 0) {
                victory = true;
                combatStatus.textContent = '¡Nosk cae! El verdadero Zote aparece y te otorga una nueva habilidad.';
                nextRoomForm.style.display = 'block';
            }
        } else {
            playerHp = Math.max(0, playerHp - 10);
            playerHpBar.style.width = playerHp + '%';
            combatStatus.textContent = 'Fallaste el golpe. Nosk aprovecha la oportunidad.';

            if (playerHp <= 0) {
                combatStatus.textContent = 'La caza termina contigo. Inténtalo de nuevo.';
                parts.forEach(part => part.style.pointerEvents = 'none');
                setTimeout(() => location.reload(), 1800);
            }
        }
    }

    // start disabled until pre-battle intro finishes
    parts.forEach(part => {
        part.style.pointerEvents = 'none';
    });

    enemyHpBar.style.width = enemyHp + '%';
    playerHpBar.style.width = playerHp + '%';

    function startCombat() {
        parts.forEach(part => {
            part.style.pointerEvents = '';
            part.addEventListener('click', () => doAttack(part));
        });
        window.combatInterval = window.setInterval(() => {
            if (!victory) {
                triggerEnemyAttack();
            }
        }, 1800);
    }

    // Start combat when user clicks the start button in the overlay
    const prebattle = document.getElementById('prebattleOverlay');
    const startBtn = document.getElementById('startCombatBtn');
    if(startBtn){
        startBtn.addEventListener('click', ()=>{
            if (prebattle) prebattle.style.display = 'none';
            startCombat();
        });
    } else {
        // fallback: start automatically after 3.5s if button not present
        setTimeout(() => {
            if (prebattle) prebattle.style.display = 'none';
            startCombat();
        }, 3500);
    }
</script>
